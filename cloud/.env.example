# Copy to cloud/.env on each node and keep it untracked. Never commit a real token.
REPORL_POLICY_SERVER_TOKEN=

# The model revision is pinned for reproducibility. Update it deliberately, not to "main".
REPORL_MODEL_ID=Qwen/Qwen2.5-Coder-3B-Instruct
REPORL_MODEL_REVISION=488639f1ff808d1d3d0ba301aef8c11461451ec5
# Leave empty for base-policy rollout. Set this after SFT for GRPO rollout.
REPORL_ADAPTER_PATH=
REPORL_POLICY_PORT=8010
REPORL_POLICY_STARTUP_TIMEOUT=600
REPORL_MAX_INPUT_TOKENS=4096
REPORL_MAX_NEW_TOKENS=256
REPORL_TEMPERATURE=0.7
REPORL_TOP_P=0.95

# Split deployment: the CPU node opens an SSH local forward to the GPU node.
REPORL_GPU_HOST=
REPORL_GPU_SSH_USER=root
REPORL_GPU_SSH_PORT=22
REPORL_TUNNEL_LOCAL_PORT=8010
REPORL_TUNNEL_REMOTE_PORT=8010
REPORL_POLICY_URL=http://127.0.0.1:8010

# Outer collector-process watchdog only. Trajectory wall time comes from the sealed TaskSpec;
# rollout.policy caps HTTP calls, and trusted suite commands cap Docker execution.
REPORL_COLLECTION_TIMEOUT_SECONDS=86400

# Optional repositories used to form image@sha256 references during task materialization.
# REPORL_AGENT_IMAGE_REPOSITORY=ghcr.io/your-org/reporl-agent
# REPORL_VERIFIER_IMAGE_REPOSITORY=ghcr.io/your-org/reporl-verifier

# Optional overrides. Uncomment only after choosing persistent absolute paths.
# REPORL_VENV_DIR=/persistent/RepoRL/.venv-cloud
# REPORL_CLOUD_STATE_DIR=/persistent/RepoRL/.reporl/cloud
# HF_HOME=/persistent/hf-cache
# TRANSFORMERS_CACHE=/persistent/hf-cache/transformers
